# Namen und Zweck, nie Werte. Geheimnisse als Secret in Cloudflare (wrangler secret put NAME).
PUBLIC_SITE_URL=             # echte Domain, steuert canonical, OG, Sitemap, robots.txt
RESEND_API_KEY=              # Versand der Reservierungsmails (Secret)
MAIL_TO=                     # interne Empfaengeradresse des Restaurants
MAIL_FROM=                   # verifizierte Absenderdomain bei Resend, z. B. reservierung@steakhouse-hauswitte.de
TURNSTILE_SECRET_KEY=        # serverseitige Pruefung des Spamschutzes (Secret)
PUBLIC_TURNSTILE_SITE_KEY=   # Widget im Formular
GOOGLE_PLACES_API_KEY=       # Bewertungsabruf, Agenturschluessel (Secret)
PUBLIC_GOOGLE_PLACE_ID=      # Place ID von Haus Witte, mit dem Kunden abgleichen
