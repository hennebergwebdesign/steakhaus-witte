# Cloudflare: Cache- und Sicherheits-Header, nach assets/vorlagen/_headers des Skills.
# /_astro/* ergänzt der Adapter beim Build selbst (immutable).

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSP bewusst noch nicht scharf: erst als Report-Only mitlaufen lassen, dann schalten.
# Erlaubt sein muss challenges.cloudflare.com (Turnstile, Skript und Rahmen).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
