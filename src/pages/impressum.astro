---
/**
 * Impressum nach der Vorlage impressum.md des Skills. Betreiberangaben aus öffentlichen
 * Verzeichnissen sind als BESTÄTIGEN markiert, Fehlendes als FEHLT. Nicht zutreffende Abschnitte
 * (Aufsichtsbehörde, Berufsrecht, MStV) sind gestrichen, nicht leer gelassen.
 */
import Rechtstext from '../layouts/Rechtstext.astro';
import { betrieb } from '../data/betrieb';
---
<Rechtstext titel="Impressum | Haus Witte Gelsenkirchen" beschreibung="Impressum von Restaurant & Steakhouse Haus Witte, Ückendorfer Straße 205, 45886 Gelsenkirchen.">
  <h1>Impressum</h1>

  <h2>Angaben gemäß § 5 DDG</h2>
  <p>
    <span class="fehlt">[[BESTÄTIGEN: Haus Witte GmbH, laut Handelsregisterangabe eines Verzeichnisses]]</span><br />
    {betrieb.name}<br />
    {betrieb.strasse}<br />
    {betrieb.plz} {betrieb.ort}
  </p>

  <h2>Vertreten durch</h2>
  <p class="fehlt">[[FEHLT: Name der Geschäftsführung]]</p>

  <h2>Kontakt</h2>
  <p>
    Telefon: <a href={betrieb.telefonLink}>{betrieb.telefon}</a><br />
    E-Mail: <span class="fehlt">[[FEHLT: E-Mail-Adresse]]</span>
  </p>

  <h2>Registereintrag</h2>
  <p>
    Eintragung im Handelsregister<br />
    Registergericht: <span class="fehlt">[[BESTÄTIGEN: Amtsgericht Gelsenkirchen]]</span><br />
    Registernummer: <span class="fehlt">[[BESTÄTIGEN: HRB 13783]]</span>
  </p>

  <h2>Umsatzsteuer-Identifikationsnummer</h2>
  <p>
    Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz:
    <span class="fehlt">[[FEHLT: USt-IdNr.]]</span>
  </p>

  <h2>Streitschlichtung</h2>
  <p>
    Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer
    Verbraucherschlichtungsstelle teilzunehmen.
  </p>

  <h2>Bildnachweise</h2>
  <p>
    Fotos: Haus Witte. <span class="fehlt">[[FEHLT: Fotograf oder Rechteinhaber, falls genannt werden soll; Herkunft des Dessertfotos]]</span>
  </p>

  <h2>Haftung für Inhalte und Links</h2>
  <p>
    Als Diensteanbieter sind wir gemäß § 7 Abs. 1 DDG für eigene Inhalte auf diesen Seiten nach
    den allgemeinen Gesetzen verantwortlich. Nach §§ 8 bis 10 DDG sind wir als Diensteanbieter
