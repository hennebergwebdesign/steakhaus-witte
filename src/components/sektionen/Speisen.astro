---
/**
 * Speisen: drei Angebote mit klarer Rangfolge. Das Steak ist gross, Mittagstisch und Dessert
 * kleiner daneben, statt drei gleich breiter Karten (26-geschmack-und-ki-tells.md, Abschnitt 5).
 * Fotos aus dem Upload des Kunden: Steak auf dem heißen Stein (Ausschnitt ohne die Gäste),
 * die Salatbar des Mittagstischs. Das Dessertfoto stammt von der alten Seite (Rechte klären).
 * Jede Karte springt zur passenden Seite der Speisekarte (data-karte-seite).
 */
import { Picture } from 'astro:assets';
import steak from '../../assets/bilder/steak-heisser-stein.webp';
import salatbar from '../../assets/bilder/salatbar.webp';
import dessert from '../../assets/bilder/palatschinken.png';
import Icon from '../Icon.astro';

const karten = [
  {
    id: 'steaks',
    titel: 'Steaks vom Holzkohlengrill',
    text: 'Rindfleisch ausschließlich von Black Ranch aus Argentinien, über Holzkohle gegrillt.',
    vorschlag: true,
    bild: steak,
    alt: 'Gegrilltes Rindersteak auf dem heißen Stein, dazu Kartoffelspalten, Pommes frites, Rahmspinat, Champignons und drei Saucen',
    link: 'Steaks in der Karte',
    seite: 'steaks',
    gross: true,
  },
  {
    id: 'mittag',
    titel: 'Mittagstisch',
    text: 'Zu unseren Mittagsgerichten servieren wir eine Tagessuppe und Sie dürfen sich an unserer reichhaltigen Salat-Bar bedienen. Die Mittagskarte wechselt monatlich.',
    vorschlag: false,
    bild: salatbar,
    alt: 'Salatbar im Gastraum, Theke mit dem Schriftzug Steakhouse Haus Witte',
    link: 'Zur Mittagskarte',
    seite: 'mittagskarte',
    gross: false,
  },
  {
    id: 'dessert',
    titel: 'Desserts',
    text: 'Palatschinken, Apfelstrudel, Heiße Liebe und Eisbecher zum Abschluss.',
    vorschlag: true,
    bild: dessert,
    alt: 'Palatschinken mit Schokoladensauce und Kirschen',
    link: 'Zu den Desserts',
    seite: 'desserts',
    gross: false,
  },
];
---
<section class="sektion speisen" id="speisen" aria-labelledby="speisen-titel">
  <div class="inhalt--weit">
    <div class="kopfzeile">
      <h2 id="speisen-titel">Steak, Mittagstisch und Dessert</h2>
    </div>

    <div class="speisen__raster">
      {karten.map((k) => (
        <article class:list={['speise', 'hebt', { 'speise--gross': k.gross }]}>
          <div class="speise__bild zoomt">
            <Picture
              fallbackFormat="webp"
              src={k.bild}
              formats={['avif', 'webp']}
              widths={k.gross ? [640, 960, 1320] : [480, 777]}
              sizes={k.gross ? '(min-width: 1360px) 1320px, 94vw' : '(min-width: 861px) 46vw, 92vw'}
              alt={k.alt}
              loading="lazy"
            />
          </div>
          <div class="speise__text">
            <h3>{k.titel}</h3>
            <p data-copy-vorschlag={k.vorschlag ? '' : undefined}>{k.text}</p>
            <a class="speise__link" href="#speisekarte" data-karte-seite={k.seite}>
              {k.link}<Icon name="pfeil-rechts" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .speisen__raster {
    display: grid;
    gap: var(--raum-spalte);
    grid-template-columns: 1fr;
  }
  @media (min-width: 861px) {
    .speisen__raster { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .speise--gross { grid-column: 1 / -1; }
  }

  .speise {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--farbe-flaeche);
    border: 1px solid var(--farbe-rahmen);
    border-radius: var(--radius-m);
    overflow: hidden;
  }
  .speise__bild { aspect-ratio: 16 / 9; background: var(--farbe-flaeche-alt); }
  .speise__bild :global(picture), .speise__bild :global(img) { width: 100%; height: 100%; }
  .speise__bild :global(img) { object-fit: cover; }
  .speise--gross .speise__bild :global(img) { object-position: 45% 70%; }

  /* Steakkarte: Foto als Fläche, Text unten links auf Holzkohleverlauf */
  .speise--gross {
    isolation: isolate;
    justify-content: flex-end;
    background: var(--farbe-flaeche-dunkel);
    border-color: var(--farbe-flaeche-dunkel);
    color: var(--farbe-text-invers);
    --farbe-fokus: var(--farbe-marke-auf-dunkel);
  }
  /* schmal: Foto oben, Text darunter auf Holzkohle, damit nichts über hellen Tellern steht */
  .speise--gross { min-height: 0; }
  .speise--gross .speise__bild { aspect-ratio: 16 / 9; }
  /* breit: Text links auf eigener Holzkohlefläche, das Steak rechts frei sichtbar */
  @media (min-width: 861px) {
    .speise--gross { justify-content: center; min-height: clamp(22rem, 38vw, 34rem); }
    .speise--gross .speise__bild { position: absolute; inset: 0 0 0 34%; z-index: -2; aspect-ratio: auto; }
    .speise--gross::before {
      content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background: linear-gradient(to right, var(--farbe-flaeche-dunkel) 0%, var(--farbe-flaeche-dunkel) 34%, color-mix(in oklab, var(--farbe-flaeche-dunkel) 40%, transparent) 46%, transparent 60%), var(--verlauf-glut);
    }
    .speise--gross .speise__text { max-width: 40%; }
  }
  .speise--gross .speise__text { padding: var(--raum-8); gap: var(--raum-4); }
  .speise--gross .speise__text p { color: var(--farbe-text-invers); font-size: var(--text-lg); max-width: 30rem; }
  .speise--gross .speise__link { color: var(--farbe-marke-auf-dunkel); }
  .speise__text { padding: var(--raum-6); display: grid; gap: var(--raum-3); }
  .speise__text h3 { margin: 0; }
  .speise--gross .speise__text h3 { font-size: var(--text-h2); }
  .speise__text p { margin: 0; color: var(--farbe-text-leise); }

  .speise__link {
    display: inline-flex; align-items: center; gap: var(--raum-2);
    font-weight: 600; text-decoration: none; min-height: var(--ziel-min);
    justify-self: start;
  }
  .speise__link :global(.icon) { transition: transform var(--dauer-schnell) var(--kurve); }
  @media (hover: hover) and (pointer: fine) {
    .speise__link:hover :global(.icon) { transform: translateX(var(--raum-1)); }
  }
  /* Die ganze Karte ist klickbar, der Link bleibt das eine Fokusziel */
  .speise__link::after { content: ''; position: absolute; inset: 0; }
  .speise:focus-within { outline: 3px solid var(--farbe-fokus); outline-offset: 3px; }
  .speise__link:focus-visible { outline: none; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .speise__link:hover :global(.icon) { transform: none; }
  }
</style>
