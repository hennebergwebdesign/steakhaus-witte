---
/**
 * Eigenes Icon-Set Haus Witte: 24er Raster, Linie 2 px, runde Kappen und Ecken.
 * Strichstaerke folgt Zilla Slab 700 (marke.json, icons). Ein Set fuer alles,
 * damit keine fremde Strichstaerke neben der eigenen steht.
 */
interface Props {
  name:
    | 'telefon' | 'uhr' | 'ort' | 'personen' | 'kalender' | 'buch'
    | 'facebook' | 'instagram' | 'google' | 'stern'
    | 'pfeil-rechts' | 'pfeil-links' | 'menue' | 'schliessen' | 'route';
  titel?: string;
  class?: string;
}
const { name, titel, class: klasse } = Astro.props;

const pfade: Record<Props['name'], string> = {
  telefon:
    '<path d="M6.6 3.5h2.6l1.4 4.1-1.9 1.4a11.5 11.5 0 0 0 6.3 6.3l1.4-1.9 4.1 1.4v2.6a2 2 0 0 1-2.2 2A16.7 16.7 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"/>',
  uhr: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  ort: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  personen:
    '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><path d="M15.5 5.8a3 3 0 0 1 0 5.4"/><path d="M17 14.7c2 .6 3.2 2.3 3.5 4.8"/>',
  kalender:
    '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  buch:
    '<path d="M12 6.5c-1.8-1.5-4.6-2-8-1.8v13.5c3.4-.2 6.2.3 8 1.8 1.8-1.5 4.6-2 8-1.8V4.7c-3.4-.2-6.2.3-8 1.8Z"/><path d="M12 6.5V20"/>',
  facebook:
    '<path d="M14.5 21v-7.5h2.7l.4-3h-3.1V8.6c0-.9.3-1.6 1.6-1.6h1.6V4.3a21 21 0 0 0-2.4-.1c-2.4 0-4 1.4-4 4.1v2.2H8.6v3h2.7V21"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17 7h.01"/>',
  google:
    '<path d="M20 12.2c0-.6-.1-1.1-.2-1.7H12v3.3h4.5a4.6 4.6 0 0 1-2 2.9"/><path d="M14.5 16.7A7.5 7.5 0 1 1 17.2 6.6"/>',
  stern:
    '<path d="m12 3.8 2.5 5.1 5.6.8-4 3.9.9 5.6-5-2.6-5 2.6.9-5.6-4-3.9 5.6-.8L12 3.8Z"/>',
  'pfeil-rechts': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'pfeil-links': '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  menue: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  schliessen: '<path d="M6 6l12 12M18 6 6 18"/>',
  route: '<circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M8 18h7.5a3 3 0 0 0 0-6h-7a3 3 0 0 1 0-6H16"/>',
};
---
<svg
  class:list={['icon', klasse]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={titel ? undefined : 'true'}
  role={titel ? 'img' : undefined}
  aria-label={titel}
  focusable="false"
  set:html={pfade[name]}
/>
